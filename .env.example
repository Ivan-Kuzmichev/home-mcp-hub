# Public URL of the hub, without the secret prefix. For a LAN test use http://<nas-ip>:3000
BASE_URL=http://localhost:3000
# SQLite file; in the container it is /data/hub.db
DATABASE_PATH=./data/hub.db
# openssl rand -hex 32  (keep .env at chmod 600, never commit it)
HUB_MASTER_KEY=
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Used only when the user table is empty (first start)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Trust X-Forwarded-* from Traefik/Pangolin
TRUST_PROXY=0
LOG_LEVEL=info

# docker-compose.yml only
GHCR_OWNER=your-github-user
PANGOLIN_ENDPOINT=https://pangolin.example.com
NEWT_ID=
NEWT_SECRET=
TZ=Europe/Moscow

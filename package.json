{
  "name": "home-mcp-hub",
  "version": "0.19.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:addon": "python3 -m unittest discover -s addons/mitmproxy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "auth:schema": "auth generate --config scripts/auth-schema.ts --adapter drizzle --dialect sqlite --output lib/db/auth-schema.ts --yes",
    "release": "node scripts/release.mjs",
    "demo": "node scripts/demo/capture.mjs",
    "screenshots": "node scripts/demo/capture.mjs --screenshots"
  },
  "dependencies": {
    "@better-auth/mcp": "1.7.14",
    "@better-auth/oauth-provider": "1.7.14",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@napi-rs/canvas": "^1.1.0",
    "@node-rs/argon2": "^2.2.2",
    "better-auth": "1.7.14",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.14",
    "lucide-react": "^1.66.0",
    "mcp-handler": "^2.3.0",
    "next": "15.5.28",
    "node-cron": "^4.6.0",
    "pdf-lib": "^1.17.1",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "quickjs-emscripten": "^0.32.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "undici": "^8.12.4",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "auth": "1.7.14",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.28",
    "playwright": "^1.64.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
